# Copy to .env and fill in
# Free Gemini API key: https://aistudio.google.com/apikey
# gemini-2.5-flash has a free tier (rate-limited) — plenty for personal use.
GEMINI_API_KEY=...
# Optional: model override (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
# Your GitHub username for the Projects helper
GITHUB_USERNAME=MythilManuMuralee
# PORT=4000
# App password — set this before tunnelling or deploying so only you can use the app.
# The web app and the extension will prompt for it once.
# APP_PASSWORD=pick-a-strong-password
